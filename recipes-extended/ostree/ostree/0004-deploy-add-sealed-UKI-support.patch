+      if (dent->d_type != DT_REG)
+        continue;
+
+      guint index;
+      g_autofree char *bootid = NULL;
+      if (!_ostree_sdboot_parse_type2_filename (dent->d_name, &index, &bootid, NULL))
+        continue; /* foreign file, keep */
