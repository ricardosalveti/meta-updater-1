+          struct stat stbuf;
+          if (!glnx_fstatat_allow_noent (dfd_iter.fd, good, &stbuf, 0, error))
+            return FALSE;
+          gboolean sibling = errno == 0;
+          if (!sibling)
+            {
+              /* Also accept a counter-suffixed sibling. */
+              g_auto (GLnxDirFdIterator) scan = { 0, };
+              if (!glnx_dirfd_iterator_init_at (dfd_iter.fd, ".", FALSE, &scan, error))
+                return FALSE;
+              g_autofree char *prefix
+                  = g_strdup_printf ("ostree-%u-%s", GPOINTER_TO_UINT (live), bootid);
+              while (!sibling)
+                {
