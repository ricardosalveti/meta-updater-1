diff --git a/src/libostree/ostree-bootconfig-parser.c b/src/libostree/ostree-bootconfig-parser.c
index 4e7c823a..125fa59c 100644
--- a/src/libostree/ostree-bootconfig-parser.c
+++ b/src/libostree/ostree-bootconfig-parser.c
@@ -215,13 +215,18 @@ ostree_bootconfig_parser_parse (OstreeBootconfigParser *self, GFile *path,
  * ostree_bootconfig_parser_set:
  * @self: Parser
  * @key: the key
- * @value: the key
+ * @value: (nullable): the value, or %NULL to remove the key
  *
  * Set the @key/@value pair to the boot configuration dictionary.
  */
 void
 ostree_bootconfig_parser_set (OstreeBootconfigParser *self, const char *key, const char *value)
 {
+  if (value == NULL)
+    {
+      g_hash_table_remove (self->options, key);
+      return;
+    }
   g_hash_table_replace (self->options, g_strdup (key), g_strdup (value));
 }
 
diff --git a/src/libostree/ostree-bootloader-sd-boot.c b/src/libostree/ostree-bootloader-sd-boot.c
index d7fa7d16..0b7438ef 100644
--- a/src/libostree/ostree-bootloader-sd-boot.c
+++ b/src/libostree/ostree-bootloader-sd-boot.c
@@ -22,19 +22,47 @@
 
 #include "config.h"
 
+#include "ostree-bootconfig-parser-private.h"
+#include "ostree-repo-private.h"
 #include "ostree-sysroot-private.h"
 #include "ostree-bootloader-sd-boot.h"
 #include "otutil.h"
 
+#include <inttypes.h>
 #include <string.h>
 
 static const char sdboot_config_path[] = "boot/loader/loader.conf";
+/* systemd-boot auto-discovers type-2 entries (UKIs) from this directory on the ESP.
+ * Relative to the boot fd (i.e. the ESP root), not the sysroot fd. */
+static const char sdboot_uki_dir[] = "EFI/Linux";
+static const char sdboot_default_line[] = "default ostree-*";
+
+/* One UKI to publish into EFI/Linux; built in write_config, executed in post_bls_sync. */
+typedef struct
+{
+  char *bootid;      /* deployment selector, matches the sealed ostree=/ostree/root.BOOTID */
+  guint index;       /* n_deployments - deployment_index, mirrors bootloader_entry_filename */
+  char *src_relpath; /* the deployment's UKI, relative to boot_fd */
+  char *seed_counter; /* boot-counter suffix ("+L[-D]" or NULL) for a fresh publish */
+} SdbootPublishItem;
+
+static void
+sdboot_publish_item_free (SdbootPublishItem *item)
+{
+  if (!item)
+    return;
+  g_free (item->bootid);
+  g_free (item->src_relpath);
+  g_free (item->seed_counter);
+  g_free (item);
+}
 
 struct _OstreeBootloaderSdboot
 {
   GObject       parent_instance;
 
   OstreeSysroot  *sysroot;
+  GPtrArray      *pending; /* (element-type SdbootPublishItem); write_config -> post_bls_sync */
 };
 
 typedef GObjectClass OstreeBootloaderSdbootClass;
@@ -43,6 +71,65 @@ static void _ostree_bootloader_sdboot_bootloader_iface_init (OstreeBootloaderInt
 G_DEFINE_TYPE_WITH_CODE (OstreeBootloaderSdboot, _ostree_bootloader_sdboot, G_TYPE_OBJECT,
                          G_IMPLEMENT_INTERFACE (OSTREE_TYPE_BOOTLOADER, _ostree_bootloader_sdboot_bootloader_iface_init));
 
+/* A boot id is a conservative token (see ostree-sysroot-deploy.c). */
+static gboolean
+sdboot_bootid_valid (const char *bootid)
+{
+  if (!bootid || !*bootid)
+    return FALSE;
+  for (const char *p = bootid; *p; p++)
+    if (!g_ascii_islower (*p) && !g_ascii_isdigit (*p) && *p != '.' && *p != '_' && *p != '-')
+      return FALSE;
+  return TRUE;
+}
+
+/* Build "ostree-<index>-<bootid>[<counter>].efi"; @counter is "+L[-D]" or NULL. */
+char *
+_ostree_sdboot_type2_filename (guint index, const char *bootid, const char *counter)
+{
+  return g_strdup_printf ("ostree-%u-%s%s.efi", index, bootid, counter ?: "");
+}
+
+/* Parse "ostree-<index>-<bootid>[+L[-D]].efi". The bootid charset excludes '+', so the
+ * counter split is unambiguous. Returns FALSE (without error) for non-matching names. */
+gboolean
+_ostree_sdboot_parse_type2_filename (const char *name, guint *out_index, char **out_bootid,
+                                     char **out_counter)
+{
+  if (!g_str_has_prefix (name, "ostree-") || !g_str_has_suffix (name, ".efi"))
+    return FALSE;
+
+  const char *p = name + strlen ("ostree-");
+  const char *dash = strchr (p, '-');
+  if (!dash || dash == p)
+    return FALSE;
+  for (const char *q = p; q < dash; q++)
+    if (!g_ascii_isdigit (*q))
+      return FALSE;
+
+  g_autofree char *index_str = g_strndup (p, dash - p);
+  guint64 index;
+  if (!g_ascii_string_to_unsigned (index_str, 10, 0, G_MAXUINT, &index, NULL))
+    return FALSE;
+
+  const char *rest = dash + 1;                    /* "<bootid>[+L[-D]].efi" */
+  size_t rest_len = strlen (rest) - strlen (".efi");
+  const char *plus = memchr (rest, '+', rest_len);
+  size_t bootid_len = plus ? (size_t)(plus - rest) : rest_len;
+
+  g_autofree char *bootid = g_strndup (rest, bootid_len);
+  if (!sdboot_bootid_valid (bootid))
+    return FALSE;
+
+  if (out_index)
+    *out_index = (guint)index;
+  if (out_bootid)
+    *out_bootid = g_steal_pointer (&bootid);
+  if (out_counter)
+    *out_counter = plus ? g_strndup (plus, rest_len - bootid_len) : NULL;
+  return TRUE;
+}
+
 static gboolean
 _ostree_bootloader_sdboot_query (OstreeBootloader *bootloader,
                                 gboolean         *out_is_active,
@@ -64,6 +151,22 @@ _ostree_bootloader_sdboot_get_name (OstreeBootloader *bootloader)
   return "systemd-boot";
 }
 
+/* Compute the boot-counter suffix a fresh EFI/Linux file should carry, mirroring
+ * bootloader_entry_filename() in ostree-sysroot-deploy.c. Returns "+L[-D]" or NULL. */
+static char *
+sdboot_seed_counter (OstreeRepo *repo, OstreeBootconfigParser *bootconfig)
+{
+  if (!repo->boot_counting)
+    return NULL;
+  if (!_ostree_bootconfig_parser_filename (bootconfig))
+    return g_strdup_printf ("+%u", repo->boot_counting);
+  guint64 left = ostree_bootconfig_parser_get_tries_left (bootconfig);
+  guint64 done = ostree_bootconfig_parser_get_tries_done (bootconfig);
+  if (!left && !done)
+    return NULL;
+  return g_strdup_printf ("+%" PRIu64 "-%" PRIu64, left, done);
+}
+
 static gboolean
 _ostree_bootloader_sdboot_write_config (OstreeBootloader *bootloader,
                                        int               new_bootversion,
@@ -72,6 +175,9 @@ _ostree_bootloader_sdboot_write_config (OstreeBootloader *bootloader,
                                        GError          **error)
 {
   OstreeBootloaderSdboot *self = OSTREE_BOOTLOADER_SDBOOT (bootloader);
+  OstreeRepo *repo = ostree_sysroot_repo (self->sysroot);
+
+  g_clear_pointer (&self->pending, g_ptr_array_unref);
 
   /* This should follow the symbolic link to the new bootversion. */
   g_autofree char *config_contents =
@@ -80,6 +186,30 @@ _ostree_bootloader_sdboot_write_config (OstreeBootloader *bootloader,
   if (!config_contents)
     return FALSE;
 
+  /* In type-2 mode ostree publishes the UKIs into EFI/Linux and owns their ordering by
+   * file name; pin the boot loader's default to the ostree family so a stray .efi that
+   * sorts higher (or a firmware-provided entry) cannot become the default. Only add the
+   * line if the image did not already set an explicit default. */
+  g_autofree char *amended_config = NULL;
+  if (repo->sdboot_type2)
+    {
+      gboolean has_default = FALSE;
+      g_auto (GStrv) lines = g_strsplit (config_contents, "\n", -1);
+      for (char **it = lines; *it; it++)
+        if (g_str_has_prefix (g_strchug (*it), "default"))
+          {
+            has_default = TRUE;
+            break;
+          }
+      if (!has_default)
+        {
+          amended_config = g_strconcat (config_contents,
+                                        g_str_has_suffix (config_contents, "\n") ? "" : "\n",
+                                        sdboot_default_line, "\n", NULL);
+          config_contents = g_steal_pointer (&amended_config);
+        }
+    }
+
   g_autofree char *new_config_path = g_strdup_printf ("boot/loader.%d/loader.conf", new_bootversion);
   if (!glnx_file_replace_contents_at (self->sysroot->sysroot_fd, new_config_path,
                                       (guint8*)config_contents, strlen (config_contents),
@@ -87,6 +217,173 @@ _ostree_bootloader_sdboot_write_config (OstreeBootloader *bootloader,
                                       cancellable, error))
     return FALSE;
 
+  if (!repo->sdboot_type2)
+    return TRUE;
+
+  /* Build the publish plan; validation errors here abort the deploy before the
+   * boot-directory swap, leaving the running system untouched. */
+  g_autoptr (GPtrArray) plan
+      = g_ptr_array_new_with_free_func ((GDestroyNotify)sdboot_publish_item_free);
+  g_autoptr (GHashTable) seen_bootids = g_hash_table_new (g_str_hash, g_str_equal);
+  for (guint i = 0; i < new_deployments->len; i++)
+    {
+      OstreeDeployment *deployment = new_deployments->pdata[i];
+      OstreeBootconfigParser *bootconfig = ostree_deployment_get_bootconfig (deployment);
+      const char *bootid = ostree_bootconfig_parser_get (bootconfig, "x-ostree-uki-boot-id");
+      const char *uki = ostree_bootconfig_parser_get (bootconfig, "uki");
+      if (!bootid || !uki)
+        return glnx_throw (error, "systemd-boot type-2 mode requires sealed UKI deployments");
+      if (!sdboot_bootid_valid (bootid))
+        return glnx_throw (error, "Invalid ostree-boot-id '%s'", bootid);
+      if (!g_hash_table_add (seen_bootids, (gpointer)bootid))
+        return glnx_throw (error,
+                           "Two deployments share sealed boot id '%s'; redeploying the same "
+                           "image is unsupported with systemd-boot type-2 entries",
+                           bootid);
+
+      /* "uki" is bootprefix + bootcsumdir + "/" + name; make it relative to boot_fd. */
+      const char *src = uki;
+      while (*src == '/')
+        src++;
+      if (g_str_has_prefix (src, "boot/"))
+        src += strlen ("boot/");
+
+      SdbootPublishItem *item = g_new0 (SdbootPublishItem, 1);
+      item->bootid = g_strdup (bootid);
+      item->index = new_deployments->len - ostree_deployment_get_index (deployment);
+      item->src_relpath = g_strdup (src);
+      item->seed_counter = sdboot_seed_counter (repo, bootconfig);
+      g_ptr_array_add (plan, item);
+    }
+
+  self->pending = g_steal_pointer (&plan);
+  return TRUE;
+}
+
+/* An existing EFI/Linux/ostree-*.efi file, grouped per boot id. */
+typedef struct
+{
+  char *name;
+  guint index;
+  char *counter; /* "+L[-D]" or NULL */
+} SdbootExisting;
+
+static void
+sdboot_existing_free (SdbootExisting *e)
+{
+  if (!e)
+    return;
+  g_free (e->name);
+  g_free (e->counter);
+  g_free (e);
+}
+
+static gboolean
+_ostree_bootloader_sdboot_post_bls_sync (OstreeBootloader *bootloader, int bootversion,
+                                         GCancellable *cancellable, GError **error)
+{
+  OstreeBootloaderSdboot *self = OSTREE_BOOTLOADER_SDBOOT (bootloader);
+  OstreeRepo *repo = ostree_sysroot_repo (self->sysroot);
+
+  if (!repo->sdboot_type2 || !self->pending)
+    return TRUE;
+
+  if (!_ostree_sysroot_ensure_boot_fd (self->sysroot, error))
+    return FALSE;
+
+  if (!glnx_shutil_mkdir_p_at (self->sysroot->boot_fd, sdboot_uki_dir, 0755, cancellable, error))
+    return FALSE;
+  glnx_autofd int efi_dfd = -1;
+  if (!glnx_opendirat (self->sysroot->boot_fd, sdboot_uki_dir, TRUE, &efi_dfd, error))
+    return FALSE;
+
+  /* Index the existing files per boot id. Several may share a boot id if a previous
+   * publish crashed mid-rename; we pick one live representative below. */
+  g_autoptr (GHashTable) existing_by_bootid
+      = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, (GDestroyNotify)g_ptr_array_unref);
+  g_auto (GLnxDirFdIterator) dfd_iter = { 0, };
+  if (!glnx_dirfd_iterator_init_at (efi_dfd, ".", FALSE, &dfd_iter, error))
+    return FALSE;
+  while (TRUE)
+    {
+      struct dirent *dent;
+      if (!glnx_dirfd_iterator_next_dent_ensure_dtype (&dfd_iter, &dent, cancellable, error))
+        return FALSE;
+      if (dent == NULL)
+        break;
+      if (dent->d_type != DT_REG)
+        continue;
+
+      guint idx;
+      g_autofree char *bootid = NULL;
+      g_autofree char *counter = NULL;
+      if (!_ostree_sdboot_parse_type2_filename (dent->d_name, &idx, &bootid, &counter))
+        continue; /* foreign file, never touched */
+
+      GPtrArray *list = g_hash_table_lookup (existing_by_bootid, bootid);
+      if (!list)
+        {
+          list = g_ptr_array_new_with_free_func ((GDestroyNotify)sdboot_existing_free);
+          g_hash_table_insert (existing_by_bootid, g_steal_pointer (&bootid), list);
+        }
+      SdbootExisting *e = g_new0 (SdbootExisting, 1);
+      e->name = g_strdup (dent->d_name);
+      e->index = idx;
+      e->counter = g_steal_pointer (&counter);
+      g_ptr_array_add (list, e);
+    }
+
+  /* PASS 1: install fresh copies for boot ids with no existing file. New content lands
+   * before anything is renamed, and the boot-id-bearing name cannot clobber a live file. */
+  for (guint i = 0; i < self->pending->len; i++)
+    {
+      SdbootPublishItem *item = self->pending->pdata[i];
+      if (g_hash_table_contains (existing_by_bootid, item->bootid))
+        continue;
+      g_autofree char *dest
+          = _ostree_sdboot_type2_filename (item->index, item->bootid, item->seed_counter);
+      if (!_ostree_sysroot_install_into_boot (repo, NULL, self->sysroot->boot_fd, item->src_relpath,
+                                              efi_dfd, dest, cancellable, error))
+        return FALSE;
+    }
+
+  /* PASS 2: rename files whose index moved (e.g. after set-default), preserving the live
+   * boot-counter suffix; the boot loader and systemd-bless-boot own that suffix. */
+  for (guint i = 0; i < self->pending->len; i++)
+    {
+      SdbootPublishItem *item = self->pending->pdata[i];
+      GPtrArray *list = g_hash_table_lookup (existing_by_bootid, item->bootid);
+      if (!list)
+        continue;
+
+      /* Prefer a file already at the wanted index; else a blessed (counter-free) one;
+       * else the first. */
+      SdbootExisting *chosen = list->pdata[0];
+      for (guint j = 0; j < list->len; j++)
+        {
+          SdbootExisting *e = list->pdata[j];
+          if (e->index == item->index)
+            {
+              chosen = e;
+              break;
+            }
+          if (!e->counter)
+            chosen = e;
+        }
+
+      if (chosen->index == item->index)
+        continue; /* already correctly named, live counter intact */
+
+      g_autofree char *dest
+          = _ostree_sdboot_type2_filename (item->index, item->bootid, chosen->counter);
+      if (!glnx_renameat (efi_dfd, chosen->name, efi_dfd, dest, error))
+        return FALSE;
+    }
+
+  if (syncfs (efi_dfd) != 0)
+    return glnx_throw_errno_prefix (error, "syncfs(EFI/Linux)");
+
+  g_clear_pointer (&self->pending, g_ptr_array_unref);
   return TRUE;
 }
 
@@ -96,6 +393,7 @@ _ostree_bootloader_sdboot_finalize (GObject *object)
   OstreeBootloaderSdboot *self = OSTREE_BOOTLOADER_SDBOOT (object);
 
   g_clear_object (&self->sysroot);
+  g_clear_pointer (&self->pending, g_ptr_array_unref);
 
   G_OBJECT_CLASS (_ostree_bootloader_sdboot_parent_class)->finalize (object);
 }
@@ -111,6 +409,7 @@ _ostree_bootloader_sdboot_bootloader_iface_init (OstreeBootloaderInterface *ifac
   iface->query = _ostree_bootloader_sdboot_query;
   iface->get_name = _ostree_bootloader_sdboot_get_name;
   iface->write_config = _ostree_bootloader_sdboot_write_config;
+  iface->post_bls_sync = _ostree_bootloader_sdboot_post_bls_sync;
 }
 
 void
diff --git a/src/libostree/ostree-impl-system-generator.c b/src/libostree/ostree-impl-system-generator.c
index a21ff6bb..ba5d5ba9 100644
